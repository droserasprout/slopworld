<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <!-- Pin runtime packages for RimWorld 1.7; only package assemblies are shipped.
       Game references belong to the mod project. -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="AngleSharp" Version="1.8.3" />
    <PackageReference Include="Markdig" Version="0.18.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>
  <Target Name="CopyRuntime" AfterTargets="Build">
    <!-- Framework assemblies belong to the game runtime, outside mod discovery. -->
    <Delete Files="../Assemblies/System.Memory.dll;../Assemblies/System.Buffers.dll;../Assemblies/System.Numerics.Vectors.dll;../Assemblies/System.Runtime.CompilerServices.Unsafe.dll;../Assemblies/System.Text.Encoding.CodePages.dll" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="../Assemblies" />
  </Target>
</Project>
