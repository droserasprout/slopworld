<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == ''">$(HOME)/.local/share/Steam/steamapps/common/RimWorld</RimWorldManaged>
    <AssemblyName>SlopWorld</AssemblyName>
    <RootNamespace>SlopWorld</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../Assemblies/</OutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Nothing here should ever be copied next to the mod: RimWorld loads every
         DLL in Assemblies/, and a stray copy of a game assembly breaks the game. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Tmds.DBus.Protocol">
      <HintPath>../../Assemblies/Tmds.DBus.Protocol.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>../../Assemblies/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AngleSharp">
      <HintPath>../../Assemblies/AngleSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Markdig">
      <HintPath>../../Assemblies/Markdig.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>../../Assemblies/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tomlyn">
      <HintPath>../../Assemblies/Tomlyn.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Waylith supplies Unity's API through a single game-owned assembly. -->
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldManaged)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Game rendering signatures expose Waylith.Rendering.Material directly. -->
    <Reference Include="Waylith">
      <HintPath>$(RimWorldManaged)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Google.Protobuf">
      <HintPath>../../Assemblies/Google.Protobuf.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckRimWorldReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RimWorldManaged)/Assembly-CSharp.dll') Or !Exists('$(RimWorldManaged)/UnityStubs.dll') Or !Exists('$(RimWorldManaged)/Waylith.dll')"
           Text="Missing RimWorld 1.7 assemblies under $(RimWorldManaged); set RIMWORLD or MANAGED when using just, or RimWorldManaged when using dotnet build." />
  </Target>
</Project>
