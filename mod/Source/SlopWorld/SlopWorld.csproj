<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SlopWorld</AssemblyName>
    <RootNamespace>SlopWorld</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../Assemblies/</OutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Nothing here should ever be copied next to the mod: RimWorld loads every
         DLL in Assemblies/, and a stray copy of a game assembly breaks the game. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>$(HOME)/GOG Games/RimWorld/game/RimWorldLinux_Data/Managed</RimWorldManaged>
  </PropertyGroup>

  <!-- Keep one lock graph for local and CI builds. Select only the references
       below; never import or copy RimRef's other assemblies into the mod. -->
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="[1.6.4850]"
                      GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <GameReferencePath>$(RimWorldManaged)</GameReferencePath>
    <GameReferencePath Condition="'$(UseRimRef)' == 'true'">$(PkgKrafs_Rimworld_Ref)/ref/net472</GameReferencePath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../shared/magic-8-ball.txt" LogicalName="SlopWorld.Magic8Ball" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>../../Assemblies/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AngleSharp">
      <HintPath>../../Assemblies/AngleSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Text.Encoding.CodePages">
      <HintPath>../../Assemblies/System.Text.Encoding.CodePages.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Markdig">
      <HintPath>../../Assemblies/Markdig.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>../../Assemblies/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tomlyn">
      <HintPath>../../Assemblies/Tomlyn.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameReferencePath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameReferencePath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameReferencePath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameReferencePath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameReferencePath)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- EncodeToPNG/LoadImage, which is how the baked backgrounds reach the cache. -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameReferencePath)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Google.Protobuf">
      <HintPath>../../Assemblies/Google.Protobuf.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>../../Assemblies/System.Memory.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Buffers">
      <HintPath>../../Assemblies/System.Buffers.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Numerics.Vectors">
      <HintPath>../../Assemblies/System.Numerics.Vectors.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>../../Assemblies/System.Runtime.CompilerServices.Unsafe.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckRimWorldReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameReferencePath)/Assembly-CSharp.dll')"
           Text="Missing RimWorld references under $(GameReferencePath); set RIMWORLD or MANAGED when using just, or use just mod-build rimref for the pinned reference package." />
  </Target>
</Project>
