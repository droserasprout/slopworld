<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The plague's tell, modelled on Fleck_ToxGasSmall. Smoke is the wrong def: it
    is solid for six seconds and fades for another three, so a tint on it leaves
    hard coloured decals lying about the map instead of a haze passing over it.

    The colour lives here rather than in FleckCreationData.instanceColor because
    alpha is the whole point: instanceColor is combined with a separately computed
    fade alpha, where graphicData's is baked into the material.
  -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>SlopPlagueGas</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.3</fadeInTime>
    <solidTime>0</solidTime>
    <fadeOutTime>1.8</fadeOutTime>
    <growthRate>0.8</growthRate>
    <acceleration>(0, 0, 2)</acceleration>
    <graphicData>
      <texPath>Things/Gas/GasCloudThickA</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <color>(214, 92, 168, 64)</color>
    </graphicData>
  </FleckDef>

  <!--
    The cat's tell: deliberately the same cloud in the other colour, so the two
    read as one weather with two directions. A cleaning mote would say a chore was
    done, where this has to say what the pink says. Paler than the plague is pink,
    the aura being a handful of cells against a circle that eats the map.
  -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>SlopCleanAir</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.3</fadeInTime>
    <solidTime>0</solidTime>
    <fadeOutTime>1.8</fadeOutTime>
    <growthRate>0.8</growthRate>
    <acceleration>(0, 0, 2)</acceleration>
    <graphicData>
      <texPath>Things/Gas/GasCloudThickA</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <color>(148, 226, 160, 52)</color>
    </graphicData>
  </FleckDef>

</Defs>
