<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    All map clouds use this definition, modeled on Fleck_ToxGasSmall.
    Smoke stays solid for six seconds, then fades for three seconds.
    Tinting Smoke leaves distinct colored marks instead of moving haze.

    Set color in graphicData rather than FleckCreationData.instanceColor to preserve alpha in the material.
    instanceColor combines with a separately calculated fade alpha.
    graphicData includes alpha in the material itself.
    Color variation here therefore requires separate definitions, which supply the three plague hues below.

    Keep the rise gradual, consistent with the slow flecks in PlagueFx.
    Acceleration moves clouds toward the top of the map.
    Haze that rises faster than it spreads looks like exhaust.
  -->
  <FleckDef Name="SlopGasBase" ParentName="FleckBase_Thrown" Abstract="True">
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.3</fadeInTime>
    <solidTime>0</solidTime>
    <fadeOutTime>1.8</fadeOutTime>
    <growthRate>0.5</growthRate>
    <acceleration>(0, 0, 1.4)</acceleration>
    <graphicData>
      <texPath>Things/Gas/GasCloudThickA</texPath>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
  </FleckDef>

  <!-- The plague indicator uses the middle of its three hues. -->
  <FleckDef ParentName="SlopGasBase">
    <defName>SlopPlagueGas</defName>
    <graphicData>
      <color>(184, 88, 200, 38)</color>
    </graphicData>
  </FleckDef>

  <!--
    Select the other two hues per cloud, not per fleck.
    Each cloud has one shade. The map has three shades without color shimmer inside a cloud.
    Keep both hues close to the first so they appear to be the same gas, not a separate effect.
  -->
  <FleckDef ParentName="SlopGasBase">
    <defName>SlopPlagueGasDeep</defName>
    <graphicData>
      <color>(146, 76, 212, 38)</color>
    </graphicData>
  </FleckDef>

  <FleckDef ParentName="SlopGasBase">
    <defName>SlopPlagueGasWarm</defName>
    <graphicData>
      <color>(212, 96, 186, 38)</color>
    </graphicData>
  </FleckDef>

  <!--
    The cat indicator uses the same cloud shape with a different color.
    Both effects must look like related weather with opposite effects.
    A cleaning mote would imply a completed task instead of an ongoing field.
    Use a paler color because the cat aura covers only a few cells while the plague expands across the map.
    One hue is sufficient because the cat produces only one cloud at a time.
  -->
  <FleckDef ParentName="SlopGasBase">
    <defName>SlopCleanAir</defName>
    <graphicData>
      <color>(148, 226, 160, 15)</color>
    </graphicData>
  </FleckDef>

</Defs>
