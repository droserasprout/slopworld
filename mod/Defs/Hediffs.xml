<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Limits consciousness so the pawn collapses but remains alive and selectable.
       The same colonist stands again when its process restarts. -->
  <HediffDef>
    <defName>SlopOffline</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>offline</label>
    <description>The agent process is not running.</description>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- This definition supplies only a tag. Disabled health ticks prevent severity changes.
       Plague controls every effect itself. -->
  <HediffDef>
    <defName>SlopPlague</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>plague</label>
    <description>Something from the machine is in here.</description>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

</Defs>
