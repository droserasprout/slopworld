<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Caps consciousness, so the pawn collapses but stays alive and clickable
       and the same colonist gets up when its process comes back. -->
  <HediffDef>
    <defName>SlopOffline</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>offline</label>
    <description>The agent process is not running.</description>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- A tag, nothing more: with the sim stripped health never ticks, so severity
       would never move. Plague drives every effect itself. -->
  <HediffDef>
    <defName>SlopPlague</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>plague</label>
    <description>Something from the machine is in here.</description>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

</Defs>
