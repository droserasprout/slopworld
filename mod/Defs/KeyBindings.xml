<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <KeyBindingCategoryDef>
    <defName>SlopAgent</defName>
    <label>Agent</label>
    <description>Actions for the selected agent.</description>
  </KeyBindingCategoryDef>

  <KeyBindingCategoryDef>
    <defName>SlopNavigation</defName>
    <label>Navigation</label>
    <description>Move between agents and sidebar views.</description>
  </KeyBindingCategoryDef>

  <KeyBindingCategoryDef>
    <defName>SlopInterface</defName>
    <label>Interface</label>
    <description>Controls for the SlopWorld interface.</description>
  </KeyBindingCategoryDef>

  <KeyBindingCategoryDef>
    <defName>SlopPlayer</defName>
    <label>Player</label>
    <description>Actions for the player pawn.</description>
  </KeyBindingCategoryDef>

  <KeyBindingDef>
    <defName>SlopPlayerGo</defName>
    <label>Go</label>
    <category>SlopPlayer</category>
    <defaultKeyCodeA>Alpha1</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopPlayerFireball</defName>
    <label>Fireball</label>
    <category>SlopPlayer</category>
    <defaultKeyCodeA>Alpha2</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopPlayerRejuvenate</defName>
    <label>Rejuvenate</label>
    <category>SlopPlayer</category>
    <defaultKeyCodeA>Alpha3</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopPlayerTeleport</defName>
    <label>Teleport</label>
    <category>SlopPlayer</category>
    <defaultKeyCodeA>Alpha4</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopPlayerCatWhistle</defName>
    <label>Cat whistle</label>
    <category>SlopPlayer</category>
    <defaultKeyCodeA>Alpha5</defaultKeyCodeA>
  </KeyBindingDef>

  <!-- T also toggles vanilla's beauty overlay, which a colony of agents has no
       use for. -->
  <KeyBindingDef>
    <defName>SlopOpenTerminal</defName>
    <label>Open agent terminal</label>
    <category>SlopAgent</category>
    <defaultKeyCodeA>T</defaultKeyCodeA>
  </KeyBindingDef>

  <!-- Ctrl+backquote: command palette, VSCode-style. The key portion remains rebindable. -->
  <KeyBindingDef>
    <defName>SlopCommandPalette</defName>
    <label>Command palette</label>
    <category>SlopInterface</category>
    <defaultKeyCodeA>BackQuote</defaultKeyCodeA>
  </KeyBindingDef>

  <!-- S is free after StripKeys leaves only arrow keys on the camera. -->
  <KeyBindingDef>
    <defName>SlopToggleSession</defName>
    <label>Start/stop agent</label>
    <category>SlopAgent</category>
    <defaultKeyCodeA>S</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopEditSession</defName>
    <label>Edit selected agent</label>
    <category>SlopAgent</category>
    <defaultKeyCodeA>E</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopDuplicateSession</defName>
    <label>Duplicate selected agent</label>
    <category>SlopAgent</category>
    <defaultKeyCodeA>D</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopRemoveSession</defName>
    <label>Remove selected agent</label>
    <category>SlopAgent</category>
    <defaultKeyCodeA>Delete</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopLabelSession</defName>
    <label>Label selected session</label>
    <category>SlopAgent</category>
    <defaultKeyCodeA>L</defaultKeyCodeA>
  </KeyBindingDef>

  <!-- In and out of the terminal from anywhere. F12 because vanilla spends
       nothing on it; see TerminalHotkeys.cs. -->
  <KeyBindingDef>
    <defName>SlopQuickTerminal</defName>
    <label>Open/close agent terminal</label>
    <category>SlopInterface</category>
    <defaultKeyCodeA>F12</defaultKeyCodeA>
  </KeyBindingDef>

  <!-- F11 toggles the window-manager fullscreen state. -->
  <KeyBindingDef>
    <defName>SlopToggleFullscreen</defName>
    <label>Toggle fullscreen</label>
    <category>SlopInterface</category>
    <defaultKeyCodeA>F11</defaultKeyCodeA>
  </KeyBindingDef>

  <!-- F1 through F6: focus the sidebar views in their left-to-right order. Bare key = sidebar;
       Shift+F = that F-key passes through to the agent/tui. -->
  <KeyBindingDef>
    <defName>SlopSidebarAgents</defName>
    <label>Sidebar: agents view</label>
    <category>SlopNavigation</category>
    <defaultKeyCodeA>F1</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopSidebarFiles</defName>
    <label>Sidebar: files view</label>
    <category>SlopNavigation</category>
    <defaultKeyCodeA>F2</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopSidebarGit</defName>
    <label>Sidebar: Git view</label>
    <category>SlopNavigation</category>
    <defaultKeyCodeA>F3</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopSidebarSearch</defName>
    <label>Sidebar: search view</label>
    <category>SlopNavigation</category>
    <defaultKeyCodeA>F4</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopSidebarTasks</defName>
    <label>Sidebar: tasks view</label>
    <category>SlopNavigation</category>
    <defaultKeyCodeA>F5</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>SlopSidebarLibrary</defName>
    <label>Sidebar: library view</label>
    <category>SlopNavigation</category>
    <defaultKeyCodeA>F6</defaultKeyCodeA>
  </KeyBindingDef>

</Defs>
