<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- What an idle agent does instead of sleeping: nothing at all, on the spot,
       for as long as its terminal stays quiet. A colonist asleep on the floor
       reads as a process that stopped, which is the one state that already has
       a body language of its own; standing about waiting for something to
       happen is what an agent between turns is actually doing.

       Vanilla's own wait driver, which needs no target and holds its ground, so
       the def is the whole of it and the report string is the point. Nothing
       ends this job on its own - AgentColony starts it when the daemon says
       idle and ends it when the daemon says otherwise - hence
       casualInterruptible false, so the think tree cannot quietly swap the pawn
       onto a wander in between. -->
  <JobDef>
    <defName>SlopClaudwatch</defName>
    <driverClass>Verse.AI.JobDriver_Wait</driverClass>
    <reportString>claudwatching.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <alwaysShowReport>true</alwaysShowReport>
  </JobDef>

</Defs>
