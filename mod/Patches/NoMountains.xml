<?xml version="1.0" encoding="utf-8"?>
<!--
  This operation changes base game definitions only inside a SlopWorld profile.
  All SlopWorld operations that change base game definitions use this wrapper. See
  Source/SlopWorld/Bootstrap/ModProfile.cs.
-->
<Patch>
  <Operation Class="SlopWorld.PatchOperationInProfile">
    <operations>
      <li Class="PatchOperationRemove">
        <xpath>/Defs/MapGeneratorDef[defName='Base_Player']/genSteps/li[text()='RocksFromGrid']</xpath>
      </li>
    </operations>
  </Operation>
</Patch>
