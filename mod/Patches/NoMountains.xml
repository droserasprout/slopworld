<?xml version="1.0" encoding="utf-8"?>
<!--
  Wrapped, like every operation of ours that rewrites a def the base game
  shipped: outside a SlopWorld profile it is not applied at all. See
  Source/SlopWorld/Bootstrap/ModProfile.cs.
-->
<Patch>
  <Operation Class="SlopWorld.PatchOperationInProfile">
    <operations>
      <li Class="PatchOperationRemove">
        <xpath>/Defs/MapGeneratorDef[defName='Base_Player']/genSteps/li[text()='RocksFromGrid']</xpath>
      </li>
    </operations>
  </Operation>
</Patch>
