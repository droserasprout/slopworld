<?xml version="1.0" encoding="utf-8"?>
<!--
  This operation changes base game definitions only inside a SlopWorld profile.
  All SlopWorld operations that change base game definitions use this wrapper. SlopWorld's own
  SongDefs remain: the daemon plays them on the host, and MusicManagerPlay plays
  them in sidecar mode. See Source/SlopWorld/Bootstrap/ModProfile.cs.
-->
<Patch>
  <Operation Class="SlopWorld.PatchOperationInProfile">
    <operations>
      <li Class="PatchOperationRemove">
        <xpath>/Defs/SongDef[not(starts-with(defName, 'SlopWorld_'))]</xpath>
      </li>

      <li Class="PatchOperationAdd">
        <xpath>/Defs</xpath>
        <value>
          <SongDef>
            <defName>EntrySong</defName>
            <playOnMap>false</playOnMap>
            <clipPath>SlopWorld/silent</clipPath>
          </SongDef>
          <SongDef>
            <defName>EndCreditsSong</defName>
            <playOnMap>false</playOnMap>
            <clipPath>SlopWorld/silent</clipPath>
          </SongDef>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
