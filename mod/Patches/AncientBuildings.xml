<?xml version="1.0" encoding="utf-8"?>
<!--
  The base game uses racks, monitor banks, and lamps as scenery placed by map generation.
  Players cannot normally build them.
  BuildableDef.BuildableByPlayer tests designationCategory != null.
  A non-null category thus permits blueprint and frame creation, which makes these definitions available to Worksite.

  The category remains hidden. SlopWorld removes the Architect button.
  Both paths into its menu use the same Visible condition as the bar.

  These ruined structures provide the intended appearance for this map.
  They have no cost or stuff requirement, so their frames are ready on the placement tick.
  They require no construction skill, so every arriving agent can build them.

  This operation changes base game definitions only inside a SlopWorld profile.
  Other profiles retain their original Architect menu behavior.
  See Source/SlopWorld/Bootstrap/ModProfile.cs.
-->
<Patch>
  <Operation Class="SlopWorld.PatchOperationInProfile">
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[
          defName='AncientLamp' or
          defName='AncientLamppost' or
          defName='AncientSystemRack' or
          defName='AncientDisplayBank' or
          defName='AncientLockerBank' or
          defName='AncientGenerator' or
          defName='AncientMachine']</xpath>
        <value>
          <designationCategory>Misc</designationCategory>
        </value>
      </li>

      <!--
        AncientMachine is Impassable but fills only half its cell.
        ThingDef.ConfigErrors rejects this combination for a player-buildable definition because shots can pass over it.
        This map does not use shooting, so disable that configuration error.
-->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName='AncientMachine']</xpath>
        <value>
          <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
