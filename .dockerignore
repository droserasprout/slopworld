# Only send sidecar build inputs to the container builder.
*
!.dockerignore

!Cargo.toml
!Cargo.lock
!slopweb/
slopweb/*
!slopweb/host/
slopweb/host/*
!slopweb/host/Cargo.toml
!bench/
bench/*
!bench/ipc/
bench/ipc/*
!bench/ipc/rust/
bench/ipc/rust/*
!bench/ipc/rust/Cargo.toml

!slopd/
slopd/*
!slopd/Cargo.toml
!slopd/build.rs
!slopd/src/
!slopd/src/**
!slopd/presets/
!slopd/presets/**

!slopcar/
slopcar/*
!slopcar/Cargo.toml
!slopcar/entrypoint.sh
!slopcar/doctor.sh

!shared/
shared/*
!shared/slopworld.proto
!shared/magic-8-ball.txt
!shared/loading-tips.txt

!LICENSE
!licenses/
!licenses/**

!mod/
mod/*
!mod/Sounds/
mod/Sounds/*
!mod/Sounds/SlopWorld/
mod/Sounds/SlopWorld/*
!mod/Sounds/SlopWorld/OST/
mod/Sounds/SlopWorld/OST/*
!mod/Sounds/SlopWorld/OST/*.ogg
