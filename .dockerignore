# Only send sidecar build inputs to the container builder.
*
!.dockerignore

!Cargo.toml
!Cargo.lock
!bench/
bench/*
!bench/ipc/
bench/ipc/*
!bench/ipc/rust/
bench/ipc/rust/*
!bench/ipc/rust/Cargo.toml

!slopd/
slopd/*
!slopd/Cargo.toml
!slopd/build.rs
!slopd/src/
!slopd/src/**
!slopd/presets/
!slopd/presets/**

!slopcar/
slopcar/*
!slopcar/Cargo.toml
!slopcar/entrypoint.sh
!slopcar/doctor.sh

!shared/
shared/*
!shared/slopworld.proto
!shared/magic-8-ball.txt
!shared/loading-tips.txt

!LICENSE
!licenses/
!licenses/**
