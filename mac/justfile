# Native macOS workflow. Shared commands run through the root justfile.
set shell := ["bash", "-euc"]
set quiet
set working-directory := '..'

# List macOS commands
help:
    @"{{ just_executable() }}" --justfile "{{ justfile() }}" --list --unsorted

import '../just/config.just'
import 'config.just'

root_justfile := absolute_path(source_directory() / '../justfile')

# macOS

# Build the sidecar and install the mod into native macOS RimWorld
[group('macOS')]
install: game-check doctor
    "{{ just_executable() }}" --justfile "{{ root_justfile }}" MANAGED="{{ MAC_MANAGED }}" MODS="{{ MAC_MODS }}" install-mod

# Start the macOS sidecar and launch native RimWorld
[group('macOS')]
run: game-check mod-check ready
    echo "launching native macOS RimWorld against {{ SLOPCAR_ENDPOINT }}"
    SLOPD_ENDPOINT="{{ SLOPCAR_ENDPOINT }}" \
        SLOPCAR_PROFILE="{{ MAC_PROFILE }}" \
        "{{ RUNNER }}" --game-exe "{{ MAC_GAME }}" --working-dir "{{ MAC_RESOURCES }}" \
            --mods "{{ MAC_MODS }}" --profile "{{ MAC_PROFILE }}" --no-window-fix -- {{ MAC_GAME_ARGS }}

# Install and run native macOS RimWorld with the sidecar
[group('macOS')]
all:
    JUST_CMD="{{ just_executable() }}" {{ PYTHON }} -m mac.workflow all

# Build the Linux sidecar image on macOS
[group('macOS')]
build: docker-check
    "{{ just_executable() }}" --justfile "{{ root_justfile }}" sidecar-build

# Verify nested Bubblewrap, pasta and tmux on macOS
[group('macOS')]
doctor: build
    "{{ just_executable() }}" --justfile "{{ root_justfile }}" sidecar-doctor

[group('macOS')]
[private]
ready: build
    {{ SLOPCAR_ENV }} {{ PYTHON }} -m mac.workflow start {{ SLOPCAR_START_ARGS }}

# Start the configured macOS sidecar, reusing its container
[group('macOS')]
start: docker-check
    {{ SLOPCAR_ENV }} {{ PYTHON }} -m mac.workflow start {{ SLOPCAR_START_ARGS }}

# Stop the macOS sidecar without removing its state
[group('macOS')]
stop: docker-check
    {{ SLOPCAR_ENV }} {{ SLOPCAR }} stop

# Show macOS sidecar status
[group('macOS')]
status: docker-check
    {{ SLOPCAR_ENV }} {{ SLOPCAR }} status

# Show macOS sidecar logs. Use LOG_ARGS='--tail 100' to limit output.
[group('macOS')]
logs: docker-check
    {{ SLOPCAR_ENV }} {{ SLOPCAR }} logs {{ LOG_ARGS }}

# Install the macOS build tools and Docker Desktop with Homebrew
[group('macOS')]
setup:
    bash mac/setup.sh

# Check Docker Desktop on macOS
[group('macOS')]
docker-check:
    {{ PYTHON }} -m mac.workflow docker-check

# Check the native macOS RimWorld and .NET SDK paths
[group('macOS')]
game-check:
    {{ PYTHON }} -m mac.workflow game-check

# Check Docker, .NET SDK and the native macOS RimWorld install
[group('macOS')]
check: docker-check game-check

# Build SlopWorld.dll against native macOS RimWorld
[group('macOS')]
mod: game-check
    "{{ just_executable() }}" --justfile "{{ root_justfile }}" MANAGED="{{ MAC_MANAGED }}" mod

# Create the isolated native macOS sidecar profile if it is absent
[group('macOS')]
profile: daemon
    "{{ RUNNER }}" --profile "{{ MAC_PROFILE }}" --init-profile --sidecar

[group('macOS')]
[private]
mod-check:
    {{ PYTHON }} -m mac.workflow mod-check

[private]
daemon:
    "{{ just_executable() }}" --justfile "{{ root_justfile }}" daemon
