[Unit]
Description=SlopWorld agent session daemon
Documentation=https://github.com/droserasprout/slopworld

[Service]
Type=simple
ExecStart=%h/.local/bin/slopd
Restart=on-failure
RestartSec=2
Environment=SLOPD_LOG=slopd=info

# Stop slopd, not everything under it. Any tmux command forks the server if it is
# not up, into this cgroup, where the default KillMode=control-group would SIGTERM
# it on every `make install-daemon` and take every agent with it.
# Tmux::ensure_server normally keeps the server out of here; this covers the one
# forked some other way.
KillMode=process

[Install]
WantedBy=default.target
