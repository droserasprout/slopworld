set quiet

# Compile and exercise the exact Probe source without game assemblies or a browser.
test:
    dotnet run --project DispatchTests.csproj -c Release

benchmark:
    DOTNET_TieredCompilation=0 dotnet run --project DispatchTests.csproj -c Release -- --benchmark

format: restore-tools
    dotnet tool run csharpier format ../Program.cs .

lint: restore-tools
    dotnet tool run csharpier check ../Program.cs .

[private]
restore-tools:
    dotnet tool restore
