<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityStubs">
      <HintPath>$(GameDirectory)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDirectory)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Logging;Microsoft.Extensions.Logging;Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(GameDirectory)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(GameDirectory)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
