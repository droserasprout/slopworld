<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Adapters/BrowserTransport.cs" Link="BrowserTransport.cs" />
    <Compile Include="../Adapters/BrowserActivity.cs" Link="BrowserActivity.cs" />
    <Compile Include="../BrowserWorkspace.cs" Link="BrowserWorkspace.cs" />
  </ItemGroup>
</Project>
