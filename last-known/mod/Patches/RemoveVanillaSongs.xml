<?xml version="1.0" encoding="utf-8"?>
<!--
  Wrapped, like every operation of ours that rewrites a def the base game
  shipped: outside a SlopWorld profile it is not applied at all. Deleting
  somebody's soundtrack because they ticked a mod on is the clearest case of
  the lot. See Source/SlopWorld/SlopProfile.cs.
-->
<Patch>
  <Operation Class="SlopWorld.PatchOperationInProfile">
    <operations>
      <li Class="PatchOperationRemove">
        <xpath>/Defs/SongDef[not(starts-with(defName, 'SlopWorld_'))]</xpath>
      </li>

      <li Class="PatchOperationAdd">
        <xpath>/Defs</xpath>
        <value>
          <SongDef>
            <defName>EntrySong</defName>
            <playOnMap>false</playOnMap>
            <clipPath>SlopWorld/silent</clipPath>
          </SongDef>
          <SongDef>
            <defName>EndCreditsSong</defName>
            <playOnMap>false</playOnMap>
            <clipPath>SlopWorld/silent</clipPath>
          </SongDef>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
