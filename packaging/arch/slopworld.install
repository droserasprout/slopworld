# shellcheck shell=bash

post_install() {
  cat <<'EOF'
SlopWorld is installed.

The mod is staged at /usr/share/slopworld/SlopWorld. RimWorld loads mods from
inside its own install, so attach it as your normal user (not root):

  RIMWORLD=/path/to/RimWorld/game
  slopworld mod install --game "$RIMWORLD"

For a local server, install slopd and slopctl separately, then start it for your user:

  systemctl --user enable --now slopd.service
EOF
}

post_upgrade() {
  cat <<'EOF'
SlopWorld was upgraded. Refresh the mod as your normal user:

  slopworld mod install

EOF
}
