# shellcheck shell=bash

post_install() {
  cat <<'EOF'
SlopWorld is installed.

The mod is staged at /usr/share/slopworld/SlopWorld. RimWorld loads mods from
inside its own install, so attach it as your normal user (not root):

  RIMWORLD=/path/to/RimWorld/game
  ln -sT /usr/share/slopworld/SlopWorld "$RIMWORLD/Mods/SlopWorld"

Then start the daemon for your user:

  systemctl --user enable --now slopd.service

The Ananicy rule is installed at /etc/ananicy.d/slopworld.rules. Restart your
Ananicy service if it was already running so it loads the new rule.
EOF
}

post_upgrade() {
  cat <<'EOF'
SlopWorld was upgraded. Reload the unit and restart the daemon as your normal user:

  systemctl --user daemon-reload
  systemctl --user try-restart slopd.service

Restart your Ananicy service if it was already running so it loads the new rule.
EOF
}
