# Maintainer: Lev Gorodetskii <aur@drsr.io>
#
# Builds the working tree this file sits in. From packaging/arch:
#
#   makepkg -p PKGBUILD.local -si
#
# The mod half links against the game's own assemblies, so RIMWORLD must point at
# a real Linux install (default ~/.local/share/Steam/steamapps/common/RimWorld, override in the environment).

pkgbase=slopworld
pkgname=('slopworld' 'slopd' 'slopctl')
pkgver=0.0.14
pkgrel=1
pkgdesc="RimWorld with the colony sim replaced by live AI coding agents"
arch=('x86_64')
url="https://github.com/droserasprout/slopworld"
license=('MIT')
makedepends=('cargo' 'git' 'dotnet-sdk' 'lld' 'just' 'protobuf' 'python' 'uv' 'alsa-lib' 'dbus' 'systemd')
options=('!strip' '!debug')
source=()
source "$startdir/packages.sh"

: "${RIMWORLD:=$HOME/.local/share/Steam/steamapps/common/RimWorld}"
_managed="${MANAGED:-$RIMWORLD}"
_src="$(realpath "$startdir/../..")"

pkgver() {
  local _v
  _v="$(cat "$srcdir/slopworld/.slopworld-build-version")"
  # Arch package versions cannot contain the hyphens used by untagged binaries.
  printf '%s\n' "${_v//-/.r}"
}

prepare() {
  [ -f "$_managed/Assembly-CSharp.dll" ] || {
    echo "no RimWorld install at $RIMWORLD; set RIMWORLD=<path>" >&2
    return 1
  }
  # makepkg's own directories sit inside the tree being copied, this file living
  # in it, so the copy has to be told to walk around them or it walks into
  # itself. tar rather than cp, which has no way to say that.
  local _skip=(
    --exclude=./.git
    --exclude=./.venv
    --exclude=./.worktrees
    --exclude=./priv
    --exclude=./target
    --exclude=./dist
    --exclude=./coverage
    --exclude=./slopd/target
    --exclude=./slopcar/target
    --exclude=./mod/Source/SlopWorld/obj
    --exclude=./mod/Source/SlopWorld/bin
    --exclude=./mod/Dependencies/obj
    --exclude=./mod/Dependencies/bin
    --exclude=./mod/Tests/obj
    --exclude=./mod/Tests/bin
    --exclude=./bench/ipc/rust/target
    --exclude=./bench/ipc/csharp/obj
    --exclude=./bench/ipc/csharp/bin
    --exclude=./bench/terminal-input/tests/http_transport/obj
    --exclude=./bench/terminal-input/tests/http_transport/bin
    --exclude=./mod/Assemblies/SlopWorld.dll
    '--exclude=./packaging/arch/*.pkg.tar.*'
  )
  local _d
  for _d in "$srcdir" "$pkgdir" "$startdir"/{src,pkg}; do
    [[ $_d == "$_src"/* ]] && _skip+=("--exclude=./${_d#"$_src"/}")
  done

  rm -rf "$srcdir/slopworld"
  mkdir -p "$srcdir/slopworld"
  # makepkg enables errexit but not pipefail; reject a partial source archive.
  (set -o pipefail; tar -C "$_src" -cf - "${_skip[@]}" . | tar -C "$srcdir/slopworld" -xf -)
  # The snapshot has no Git metadata. Capture its version from the source checkout
  # once so pkgver, build and check cannot disagree after a checkout or date change.
  (cd "$_src" && python -m tools.version.mod_version) \
    > "$srcdir/slopworld/.slopworld-build-version"
  cd "$srcdir/slopworld" || return
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --manifest-path slopd/Cargo.toml --locked
  uv sync --locked --no-python-downloads
}

build() {
  cd "$srcdir/slopworld" || return
  local _version
  _version="$(cat .slopworld-build-version)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$PWD/target" SLOPWORLD_BUILD_VERSION="$_version"
  UV_OFFLINE=true just BUILD=release CARGOFLAGS='--release --frozen' VERSION="$_version" RIMWORLD="$RIMWORLD" build
}

check() {
  cd "$srcdir/slopworld" || return
  local _version
  _version="$(cat .slopworld-build-version)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$PWD/target" SLOPWORLD_BUILD_VERSION="$_version"
  cd slopd || return
  cargo test --release --frozen
}

package_slopworld() {
  pkgdesc="${_slopworld_desc}"
  depends=("${_slopworld_depends[@]}")
  optdepends=("${_slopworld_optional[@]}")
  provides=()
  conflicts=('slopworld-git')
  install=slopworld.install
  _package_native slopworld
}

package_slopd() {
  pkgdesc="${_slopd_desc}"
  depends=("${_slopd_depends[@]}" 'slopctl')
  optdepends=("${_slopd_optional[@]}")
  provides=()
  conflicts=('slopd-git')
  _package_native slopd
}

package_slopctl() {
  pkgdesc="${_slopctl_desc}"
  depends=("${_slopctl_depends[@]}")
  optdepends=("${_slopctl_optional[@]}")
  provides=()
  conflicts=('slopctl-git')
  _package_native slopctl
}
