# Maintainer: Lev Gorodetskii <slopworld@drsr.io>
#
# Tracks the main branch for an always-current development build.
#
# The mod half links against the game's own assemblies, so RIMWORLD must point at
# a real Linux install (default ~/.local/share/Steam/steamapps/common/RimWorld, override in the environment).

pkgbase=slopworld-git
pkgname=('slopworld-git' 'slopd-git' 'slopctl-git')
pkgver=0.0.14.r0.gHEAD
pkgrel=1
pkgdesc="RimWorld with the colony sim replaced by live AI coding agents (git)"
arch=('x86_64')
url="https://github.com/droserasprout/slopworld"
license=('MIT')
makedepends=('cargo' 'git' 'dotnet-sdk' 'lld' 'just' 'protobuf' 'python' 'uv' 'alsa-lib' 'dbus' 'systemd')
options=('!strip' '!debug')
source=("$pkgbase::git+https://github.com/droserasprout/slopworld.git#branch=main")
sha256sums=('SKIP')
source "$startdir/packages.sh"

: "${RIMWORLD:=$HOME/.local/share/Steam/steamapps/common/RimWorld}"
_managed="${MANAGED:-$RIMWORLD}"

pkgver() {
  cd "$srcdir/$pkgbase" || return
  local _v
  _v="$(grep -m1 '^version' slopd/Cargo.toml | cut -d'"' -f2)"
  printf '%s.r%s.g%s' "$_v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  [ -f "$_managed/Assembly-CSharp.dll" ] || {
    echo "no RimWorld install at $RIMWORLD; set RIMWORLD=<path>" >&2
    return 1
  }
  cd "$srcdir/$pkgbase" || return
  # Keep daemon, mod and check versions identical even across a UTC date change.
  python -m tools.version.mod_version \
    > .slopworld-build-version
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --manifest-path slopd/Cargo.toml --locked
  uv sync --locked --no-python-downloads
}

build() {
  cd "$srcdir/$pkgbase" || return
  local _version
  _version="$(cat .slopworld-build-version)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$PWD/target" SLOPWORLD_BUILD_VERSION="$_version"
  UV_OFFLINE=true just BUILD=release CARGOFLAGS='--release --frozen' VERSION="$_version" RIMWORLD="$RIMWORLD" build
}

check() {
  cd "$srcdir/$pkgbase" || return
  local _version
  _version="$(cat .slopworld-build-version)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$PWD/target" SLOPWORLD_BUILD_VERSION="$_version"
  cd slopd || return
  cargo test --release --frozen
}

package_slopworld-git() {
  pkgdesc="${_slopworld_desc}"
  depends=("${_slopworld_depends[@]}")
  optdepends=("${_slopworld_optional[@]}")
  provides=('slopworld')
  conflicts=('slopworld')
  install=slopworld.install
  _package_native slopworld
}

package_slopd-git() {
  pkgdesc="${_slopd_desc}"
  depends=("${_slopd_depends[@]}" 'slopctl-git')
  optdepends=("${_slopd_optional[@]}")
  provides=('slopd')
  conflicts=('slopd')
  _package_native slopd
}

package_slopctl-git() {
  pkgdesc="${_slopctl_desc}"
  depends=("${_slopctl_depends[@]}")
  optdepends=("${_slopctl_optional[@]}")
  provides=('slopctl')
  conflicts=('slopctl')
  _package_native slopctl
}
