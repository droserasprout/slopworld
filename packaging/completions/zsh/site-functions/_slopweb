#compdef slopweb

autoload -U is-at-least

_slopweb() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--game=[]:GAME:_files' \
'--port=[]:PORT:_default' \
'(--url --token-file)--endpoint=[]:ENDPOINT:_default' \
'--url=[]:URL:_default' \
'--token-file=[]:TOKEN_FILE:_files' \
'--cache=[]:CACHE:_files' \
'--profile=[]:PROFILE:_files' \
'--public-origin=[]:PUBLIC_ORIGIN:_default' \
'--aot-sdk=[]:AOT_SDK:_files' \
'--sidecar[]' \
'--prepare[]' \
'--rebuild[]' \
'(--aot --aot-sdk)--interpreted[]' \
'--aot[]' \
'--ensure-workload[Provision a missing AOT workload for checkout development only]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_slopweb_commands" \
"*::: :->slopweb" \
&& ret=0
    case $state in
    (slopweb)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:slopweb-command-$line[1]:"
        case $line[1] in
            (paths)
_arguments "${_arguments_options[@]}" : \
'--game=[]:GAME:_files' \
'(--url --token-file)--endpoint=[]:ENDPOINT:_default' \
'--url=[]:URL:_default' \
'--token-file=[]:TOKEN_FILE:_files' \
'--cache=[]:CACHE:_files' \
'--profile=[]:PROFILE:_files' \
'--sidecar[]' \
'-h[Print help]' \
'--help[Print help]' \
':name:(config data cache endpoint profile game-log web-cache game)' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--game=[]:GAME:_files' \
'(--url --token-file)--endpoint=[]:ENDPOINT:_default' \
'--url=[]:URL:_default' \
'--token-file=[]:TOKEN_FILE:_files' \
'--cache=[]:CACHE:_files' \
'--profile=[]:PROFILE:_files' \
'--sidecar[]' \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(check-fonts)
_arguments "${_arguments_options[@]}" : \
'--game=[]:GAME:_files' \
'(--url --token-file)--endpoint=[]:ENDPOINT:_default' \
'--url=[]:URL:_default' \
'--token-file=[]:TOKEN_FILE:_files' \
'--cache=[]:CACHE:_files' \
'--profile=[]:PROFILE:_files' \
'--sidecar[]' \
'-h[Print help]' \
'--help[Print help]' \
':install:_files' \
':output:_files' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_slopweb__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:slopweb-help-command-$line[1]:"
        case $line[1] in
            (paths)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(check-fonts)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_slopweb_commands] )) ||
_slopweb_commands() {
    local commands; commands=(
'paths:Print an absolute host path without preparing runtime state' \
'completions:Generate shell completions from the command tree' \
'check-fonts:Prepare native font delivery descriptors without starting a browser' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'slopweb commands' commands "$@"
}
(( $+functions[_slopweb__subcmd__check-fonts_commands] )) ||
_slopweb__subcmd__check-fonts_commands() {
    local commands; commands=()
    _describe -t commands 'slopweb check-fonts commands' commands "$@"
}
(( $+functions[_slopweb__subcmd__completions_commands] )) ||
_slopweb__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'slopweb completions commands' commands "$@"
}
(( $+functions[_slopweb__subcmd__help_commands] )) ||
_slopweb__subcmd__help_commands() {
    local commands; commands=(
'paths:Print an absolute host path without preparing runtime state' \
'completions:Generate shell completions from the command tree' \
'check-fonts:Prepare native font delivery descriptors without starting a browser' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'slopweb help commands' commands "$@"
}
(( $+functions[_slopweb__subcmd__help__subcmd__check-fonts_commands] )) ||
_slopweb__subcmd__help__subcmd__check-fonts_commands() {
    local commands; commands=()
    _describe -t commands 'slopweb help check-fonts commands' commands "$@"
}
(( $+functions[_slopweb__subcmd__help__subcmd__completions_commands] )) ||
_slopweb__subcmd__help__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'slopweb help completions commands' commands "$@"
}
(( $+functions[_slopweb__subcmd__help__subcmd__help_commands] )) ||
_slopweb__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'slopweb help help commands' commands "$@"
}
(( $+functions[_slopweb__subcmd__help__subcmd__paths_commands] )) ||
_slopweb__subcmd__help__subcmd__paths_commands() {
    local commands; commands=()
    _describe -t commands 'slopweb help paths commands' commands "$@"
}
(( $+functions[_slopweb__subcmd__paths_commands] )) ||
_slopweb__subcmd__paths_commands() {
    local commands; commands=()
    _describe -t commands 'slopweb paths commands' commands "$@"
}

if [ "$funcstack[1]" = "_slopweb" ]; then
    _slopweb "$@"
else
    compdef _slopweb slopweb
fi
