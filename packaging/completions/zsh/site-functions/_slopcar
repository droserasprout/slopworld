#compdef slopcar

autoload -U is-at-least

_slopcar() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_slopcar_commands" \
"*::: :->slopcar" \
&& ret=0
    case $state in
    (slopcar)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:slopcar-command-$line[1]:"
        case $line[1] in
            (completions)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(paths)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':name:(config data cache endpoint profile game-log)' \
&& ret=0
;;
(licenses)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(build)
_arguments "${_arguments_options[@]}" : \
'--source=[]:SOURCE:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(start)
_arguments "${_arguments_options[@]}" : \
'*--workspace=[Mount an absolute workspace at the same path (repeatable)]:WORKSPACES:_files -/' \
'*--credential-ro=[Mount a credential read-only (SOURCE=TARGET, repeatable)]:CREDENTIAL_RO:_default' \
'*--credential-rw=[Mount a credential read-write (SOURCE=TARGET, repeatable)]:CREDENTIAL_RW:_default' \
'--port=[Host and daemon port (default\: 7718)]:PORT:_default' \
'--memory=[Memory ceiling (default\: 8g)]:MEMORY:_default' \
'--cpus=[CPU ceiling (default\: 4)]:CPUS:_default' \
'--pids-limit=[Process/thread ceiling (default\: 4096)]:PIDS:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(restart)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(logs)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(shell)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(rm)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_slopcar__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:slopcar-help-command-$line[1]:"
        case $line[1] in
            (completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(paths)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(licenses)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(build)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(start)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(restart)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(logs)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(shell)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(rm)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_slopcar_commands] )) ||
_slopcar_commands() {
    local commands; commands=(
'completions:Print a shell completion script without Docker or container settings' \
'paths:Print an application path without Docker or container settings' \
'licenses:Show embedded dependency notices' \
'build:Build the image from a checkout (default\: current directory)' \
'doctor:Check nested Bubblewrap, pasta and tmux' \
'start:Create and start, or start the existing container' \
'stop:Stop without deleting persistent state' \
'restart:Restart the existing container' \
'status:Show container and health state' \
'logs:Forward all following arguments to Docker logs; use \`help logs\` for this help' \
'shell:Open an interactive shell' \
'rm:Remove only the container, preserving config and data' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'slopcar commands' commands "$@"
}
