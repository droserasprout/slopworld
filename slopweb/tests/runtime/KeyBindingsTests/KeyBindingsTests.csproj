<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../offline/Offline.csproj" />
    <Compile Include="../../../runtime/Adapters/BrowserKeyBindings.cs" Link="BrowserKeyBindings.cs" />
    <Compile Include="../../../offline/BrowserKeyBindingsPatch.cs" Link="BrowserKeyBindingsPatch.cs" />
    <Reference Include="Assembly-CSharp;UnityStubs;Waylith;Brutal.Core.Logging;Microsoft.Extensions.Logging;Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(GameDirectory)/%(Identity).dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
