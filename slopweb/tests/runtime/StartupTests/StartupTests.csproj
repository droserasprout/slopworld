<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../runtime/Adapters/BrowserSocketLimits.cs" Link="BrowserSocketLimits.cs" />
    <Compile Include="../../../runtime/Adapters/BrowserTransport.cs" Link="BrowserTransport.cs" />
    <Compile Include="../../../runtime/Adapters/BrowserActivity.cs" Link="BrowserActivity.cs" />
    <Compile Include="../../../runtime/CoreLanguagePacks.cs" Link="CoreLanguagePacks.cs" />
    <Compile Include="../../../runtime/Adapters/WorkspaceRuntime.Frames.cs" Link="WorkspaceRuntime.Frames.cs" />
  </ItemGroup>
</Project>
