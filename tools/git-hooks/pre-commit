#!/bin/sh
set -eu

branch=$(git symbolic-ref --quiet --short HEAD || true)
if [ "$branch" = main ]; then
    echo 'Commits on main are blocked. Create a worktree with slopctl.' >&2
    exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
original=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
if [ "$repo_root" = "$original" ]; then
    echo 'Commits in the original checkout are blocked. Use a worktree.' >&2
    exit 1
fi
cd "$repo_root"
python3 tools/check_plan_status.py
