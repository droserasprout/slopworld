<Project>
  <!-- Runtime.csproj only stages third-party DLLs; these rules own our C# sources. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SlopWorld' Or '$(MSBuildProjectName)' == 'SlopWorld.Tests' Or '$(MSBuildProjectName)' == 'IpcBench' Or '$(SlopwebProject)' == 'true'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
